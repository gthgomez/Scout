{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gthgomez/Scout/schemas/handoff-package-1.1.json",
  "title": "Scout Handoff Package",
  "description": "Primary agent entrypoint artifact from scout workflow run or scout handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entrypoint",
    "generated_at",
    "discovery_intent",
    "handoff_mode",
    "handoff_mode_reason",
    "workflow_preset",
    "recommended_packages",
    "suggested_commands",
    "packages"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "entrypoint": { "const": "handoff_package.json" },
    "generated_at": { "type": "string", "format": "date-time" },
    "discovery_intent": { "enum": ["beginner", "rewarded"] },
    "handoff_mode": { "enum": ["metadata_only", "static_verified"] },
    "handoff_mode_reason": { "type": ["string", "null"] },
    "workflow_preset": { "enum": ["fast", "full"] },
    "reward_disclaimer": { "type": ["string", "null"] },
    "recommended_packages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suggested_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command", "reason"],
        "properties": {
          "kind": { "const": "readonly_cli" },
          "command": { "type": "string", "minLength": 1 },
          "cwd": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoffPackageEntry" }
    }
  },
  "$defs": {
    "handoffPackageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "verdict",
        "discovery_intent",
        "income_summary",
        "has_observed_reward_metadata",
        "repo_url",
        "issue_url",
        "reward_signals",
        "evidence_ids",
        "risks",
        "denied_commands",
        "suggested_first_files",
        "allowed_actions",
        "denied_actions",
        "agent_notes"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["GREEN", "YELLOW", "RED", "GRAY"] },
        "discovery_intent": { "enum": ["beginner", "rewarded"] },
        "income_summary": { "type": ["string", "null"] },
        "has_observed_reward_metadata": { "type": "boolean" },
        "repo_url": { "type": "string", "minLength": 1 },
        "issue_url": { "type": "string", "minLength": 1 },
        "reward_signals": { "type": "array" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "denied_commands": { "type": "array" },
        "suggested_first_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "denied_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agent_notes": { "type": "string" }
      }
    }
  }
}
