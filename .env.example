# Scout environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# GitHub personal access token (classic or fine-grained)
# Fine-grained: "Public Repositories (read-only)" is sufficient
# Classic: "public_repo" scope works
# Required for full workflow preset (archive fetch)
GITHUB_TOKEN=ghp_your_token_here

# Alternative: GH_TOKEN also works (used by gh CLI)
# GH_TOKEN=ghp_your_token_here

# --- Optional Scout tuning ---

# Parallel GitHub enrichment requests (default: 4)
# SCOUT_GITHUB_CONCURRENCY=4

# Enrichment mode: auto | rest | graphql (default: auto)
# SCOUT_ENRICH_MODE=auto

# Disk cache TTL seconds (defaults: search 86400, metadata 21600)
# SCOUT_CACHE_TTL_SEARCH=86400
# SCOUT_CACHE_TTL_METADATA=21600

# GitHub search pacing between queries in ms (default: 4000)
# SCOUT_SEARCH_PACE_MS=4000

# GitHub search retries before giving up (default: 3)
# SCOUT_SEARCH_MAX_RETRIES=3

# Cooldown after a secondary rate-limit hit in ms (default: 60000, capped at 120000)
# SCOUT_SEARCH_SECONDARY_COOLDOWN_MS=60000

# Docker image for scout probe sandboxes (default: node:20-alpine)
# SCOUT_SANDBOX_IMAGE=scout-sandbox:latest

# Optional webhook URL for YOUR monitor wrapper script (Scout CLI does not read this)
# See src/scout/runbooks/monitoring-runbook.md
# SCOUT_WEBHOOK_URL=https://example.com/hooks/scout

# Optional Algora API key for verified platform metadata enrich (spike; falls back to public page scrape)
# ALGORA_API_KEY=your_algora_api_key
# ALGORA_API_BASE_URL=https://api.algora.io
# Fallback alias for ALGORA_API_KEY (read when the primary var is unset)
# SCOUT_ALGORA_API_KEY=your_algora_api_key
